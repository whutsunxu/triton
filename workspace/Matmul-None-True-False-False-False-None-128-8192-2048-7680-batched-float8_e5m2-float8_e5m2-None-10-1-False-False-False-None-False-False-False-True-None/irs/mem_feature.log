    %34 = arith.shrui %32, %c31_i32 : i32
    %35 = arith.cmpi ne, %34, %c0_i32 : i32
    %36 = arith.cmpi eq, %34, %c0_i32 : i32
    %37 = tt.atomic_rmw max, relaxed, gpu, %33, %32, %36 : (!tt.ptr<i32>, i32, i1) -> i32
    %38 = tt.atomic_rmw umin, relaxed, gpu, %33, %32, %35 : (!tt.ptr<i32>, i32, i1) -> i32
    tt.return
  }
}

